{
  "name": "courseforge",
  "version": "0.1.0",
  "description": "Local, deterministic, review-driven e-learning course engineering harness for Claude Code and Codex.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "courseforge": "bin/courseforge.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:acceptance": "node scripts/acceptance.mjs",
    "coverage": "vitest run --coverage",
    "doctor": "node bin/courseforge.mjs doctor",
    "smoke": "node bin/courseforge.mjs smoke",
    "smoke:clean": "node scripts/fresh-clone-smoke.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "courseforge": "node bin/courseforge.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@svgdotjs/svg.js": "3.2.8",
    "axe-core": "4.13.0",
    "cheerio": "1.2.0",
    "cross-spawn": "7.0.6",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "mammoth": "1.12.3",
    "marked": "18.0.13",
    "mermaid": "12.0.0",
    "playwright": "1.63.0",
    "unpdf": "1.8.1",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "@types/cross-spawn": "6.0.6",
    "@types/d3": "7.4.3",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "lucide-static": "1.47.0",
    "storybook": "10.6.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
