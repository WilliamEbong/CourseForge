# Dependencies and build output
node_modules/
dist/
storybook-static/
*.tsbuildinfo

# CourseForge local machine state (environment manifest, caches, setup fingerprints)
.courseforge/

# Test and QA output
test-results/
playwright-report/
blob-report/
coverage/
.playwright-*/
tests/.tmp/

# Per-course transient data (course audit trails themselves ARE committed when a user chooses to)
courses/*/.lock
courses/*/.cache/
courses/*/logs/tasks/

# Secrets and local overrides
.env
.env.*
!.env.example
*.local.json
.claude/settings.local.json
CLAUDE.local.md

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log

# The original bootstrap archive is preserved on disk but its extracted contents are what is versioned
CourseForge_Bootstrap_Contents_*.zip
