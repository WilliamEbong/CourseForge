        "BlinkMacSystemFont",
        "Segoe UI Variable Text",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": ["Charter", "Bitstream Charter", "Sitka Text", "Cambria", "Georgia", "serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Cascadia Mono", "SF Mono", "ui-monospace", "Menlo", "Consolas", "Liberation Mono", "monospace"]
    },
    "body": {
      "$type": "fontFamily",
      "$value": ["Charter", "Bitstream Charter", "Sitka Text", "Cambria", "Georgia", "serif"]
    },
    "heading": {
      "$type": "fontFamily",
      "$value": ["Iowan Old Style", "Palatino Linotype", "Book Antiqua", "Palatino", "Georgia", "serif"]
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 600
