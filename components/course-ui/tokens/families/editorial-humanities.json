    "headingTracking": {
      "$type": "dimension",
      "$value": {
        "value": -0.01,
        "unit": "em"
      }
    },
    "eyebrowCase": {
      "$type": "string",
      "$value": "none"
    }
  },
  "type": {
    "base": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
