{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/review-policy.schema.json",
  "title": "review-policy",
  "description": "config/review-policy.json. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "maxRepairCycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "perStageMaxRepairCycles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "CONCEPT",
          "RESEARCH_BRIEF",
          "RESEARCH_DOSSIER",
          "INSTRUCTIONAL_DESIGN",
          "STORYBOARD",
          "EDITORIAL",
          "VISUAL_DIRECTION",
          "COURSE_MODEL",
          "COURSE_BUILD",
          "COURSE_QA",
          "RELEASE"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      }
    },
    "repairSeverities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "blocker",
          "critical",
          "major",
          "minor",
          "style"
        ]
      }
    },
    "releaseBlockingSeverities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "blocker",
          "critical",
          "major",
          "minor",
          "style"
        ]
      }
    },
    "axeBlockingImpacts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "minor",
          "moderate",
          "serious",
          "critical"
        ]
      }
    },
    "onCapReached": {
      "type": "string",
      "enum": [
        "human",
        "fail"
      ]
    },
    "gateDefaults": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "CONCEPT",
          "RESEARCH_BRIEF",
          "RESEARCH_DOSSIER",
          "INSTRUCTIONAL_DESIGN",
          "STORYBOARD",
          "EDITORIAL",
          "VISUAL_DIRECTION",
          "COURSE_MODEL",
          "COURSE_BUILD",
          "COURSE_QA",
          "RELEASE"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "auto",
          "hybrid",
          "human"
        ]
      }
    },
    "riskFloors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "standard",
          "elevated",
          "high_stakes"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "enum": [
            "CONCEPT",
            "RESEARCH_BRIEF",
            "RESEARCH_DOSSIER",
            "INSTRUCTIONAL_DESIGN",
            "STORYBOARD",
            "EDITORIAL",
            "VISUAL_DIRECTION",
            "COURSE_MODEL",
            "COURSE_BUILD",
            "COURSE_QA",
            "RELEASE"
          ]
        },
        "additionalProperties": {
          "type": "string",
          "enum": [
            "auto",
            "hybrid",
            "human"
          ]
        }
      },
      "required": [
        "standard",
        "elevated",
        "high_stakes"
      ]
    },
    "intakeModes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "preserve",
          "review-only",
          "improve",
          "rebuild"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "generate": {
            "type": "boolean"
          },
          "review": {
            "type": "boolean"
          },
          "repair": {
            "type": "boolean"
          }
        },
        "required": [
          "generate",
          "review",
          "repair"
        ],
        "additionalProperties": false
      },
      "required": [
        "preserve",
        "review-only",
        "improve",
        "rebuild"
      ]
    }
  },
  "required": [
    "version",
    "maxRepairCycles",
    "perStageMaxRepairCycles",
    "repairSeverities",
    "releaseBlockingSeverities",
    "axeBlockingImpacts",
    "onCapReached",
    "gateDefaults",
    "riskFloors",
    "intakeModes"
  ],
  "additionalProperties": false
}
