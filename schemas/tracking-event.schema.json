{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/tracking-event.schema.json",
  "title": "tracking-event",
  "description": "One learner result sent to a tracking destination. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "courseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "courseTitle": {
      "type": "string",
      "maxLength": 200
    },
    "courseVersion": {
      "type": "string",
      "maxLength": 40
    },
    "learner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "id",
        "email"
      ],
      "additionalProperties": false
    },
    "percent": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "completedAt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "test": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "courseId",
    "courseTitle",
    "courseVersion",
    "learner",
    "percent",
    "passed",
    "correct",
    "total",
    "completedAt",
    "attempt",
    "test"
  ],
  "additionalProperties": false
}
