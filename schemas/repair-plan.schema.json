{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/repair-plan.schema.json",
  "title": "repair-plan",
  "description": "review/repair-plan.json. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "CONCEPT",
        "RESEARCH_BRIEF",
        "RESEARCH_DOSSIER",
        "INSTRUCTIONAL_DESIGN",
        "STORYBOARD",
        "EDITORIAL",
        "VISUAL_DIRECTION",
        "COURSE_MODEL",
        "COURSE_BUILD",
        "COURSE_QA",
        "RELEASE"
      ]
    },
    "cycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "artifactId": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "model",
        "html-direct",
        "tooling-defect"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "findingIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "critical",
              "major",
              "minor",
              "style"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "accuracy",
              "currentness",
              "evidence",
              "citation",
              "completeness",
              "scope",
              "safety",
              "alignment",
              "instructional",
              "cognitive-load",
              "assessment",
              "scenario",
              "accessibility",
              "editorial",
              "consistency",
              "visual",
              "ui",
              "ux",
              "functional",
              "performance",
              "traceability",
              "structure",
              "other"
            ]
          },
          "instruction": {
            "type": "string"
          }
        },
        "required": [
          "actionId",
          "targetId",
          "findingIds",
          "severity",
          "category",
          "instruction"
        ]
      }
    },
    "lockConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          }
        },
        "required": [
          "findingId",
          "targetId"
        ]
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unrepairable": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "cycle",
    "artifactId",
    "target",
    "actions",
    "lockConflicts",
    "deferred",
    "rejected"
  ]
}
