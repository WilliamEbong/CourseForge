{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/editorial-result.schema.json",
  "title": "editorial-result",
  "description": "Text-only editorial edits (agent wire schema: strict subset). Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "enum": [
              "title",
              "body",
              "treatment",
              "stem",
              "feedbackCorrect",
              "feedbackIncorrect",
              "rationale",
              "optionText",
              "optionFeedback",
              "targetText"
            ]
          },
          "key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "blockId",
          "field",
          "key",
          "text",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "edits",
    "notes"
  ],
  "additionalProperties": false
}
