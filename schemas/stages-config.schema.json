                "evidence",
                "citation",
                "completeness",
                "scope",
                "safety",
                "alignment",
                "instructional",
                "cognitive-load",
                "assessment",
                "scenario",
                "accessibility",
                "editorial",
                "consistency",
                "visual",
                "ui",
                "ux",
