{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/course-state.schema.json",
  "title": "course-state",
  "description": "state.json. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
