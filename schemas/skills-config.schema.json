{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/skills-config.schema.json",
  "title": "skills-config",
  "description": "config/skills.json. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CONCEPT",
                "RESEARCH_BRIEF",
                "RESEARCH_DOSSIER",
                "INSTRUCTIONAL_DESIGN",
                "STORYBOARD",
                "EDITORIAL",
                "VISUAL_DIRECTION",
                "COURSE_MODEL",
                "COURSE_BUILD",
                "COURSE_QA",
                "RELEASE"
              ]
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "description",
          "stages",
          "roles",
          "maxBytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "skills"
  ],
  "additionalProperties": false
}
