{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/fallbacks-config.schema.json",
  "title": "fallbacks-config",
  "description": "config/fallbacks.json. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "renderer": {
      "type": "object",
      "properties": {
        "maxSemanticRepairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "terminal": {
          "type": "string",
          "const": "text_equivalent"
        }
      },
      "required": [
        "maxSemanticRepairs",
        "terminal"
      ],
      "additionalProperties": false
    },
    "schemaRetries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "process": {
      "type": "object",
      "properties": {
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "backoffMs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "retries",
        "backoffMs"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "order": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "authentication_failed",
              "rate_limit",
              "overloaded",
              "billing_error",
              "invalid_request",
              "model_not_found",
              "server_error",
              "max_output_tokens",
              "timeout",
              "schema_invalid",
              "process_error",
              "unavailable",
              "unknown"
            ]
          }
        },
        "afterAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enabled",
        "order",
        "triggers",
        "afterAttempts"
      ],
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "reviewers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "fanOut": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "reviewers",
        "fanOut"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "renderer",
    "schemaRetries",
    "process",
    "backend",
    "concurrency"
  ],
  "additionalProperties": false
}
