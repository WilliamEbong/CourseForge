{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/artifact-registry.schema.json",
  "title": "artifact-registry",
  "description": "artifacts.json. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "nextSeq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^ART-\\d{4,}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^ART-\\d{4,}$"
          },
          "stage": {
            "type": "string",
            "enum": [
              "CONCEPT",
              "RESEARCH_BRIEF",
              "RESEARCH_DOSSIER",
              "INSTRUCTIONAL_DESIGN",
              "STORYBOARD",
              "EDITORIAL",
              "VISUAL_DIRECTION",
              "COURSE_MODEL",
              "COURSE_BUILD",
              "COURSE_QA",
              "RELEASE"
            ]
          },
          "path": {
            "type": "string"
          },
          "logicalKey": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "label": {
            "type": "string"
          },
          "producer": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "human",
                  "claude",
                  "codex",
                  "fake",
                  "imported",
                  "courseforge"
                ]
              },
              "backendVersion": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "taskId": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "runId": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "parents": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ART-\\d{4,}$"
            }
          },
          "schemaVersion": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "type": "string",
            "minLength": 10
          },
          "modifiedAt": {
            "type": "string",
            "minLength": 10
          },
          "humanModified": {
            "default": false,
            "type": "boolean"
          },
          "approval": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "approved",
              "rejected"
            ]
          },
          "locked": {
            "default": false,
            "type": "boolean"
          },
          "lockedIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "hash": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "hash"
              ]
            }
          },
          "reviewStatus": {
            "default": "unreviewed",
            "type": "string",
            "enum": [
              "unreviewed",
              "in_review",
              "passed",
              "failed",
              "waived"
            ]
          },
          "supersededBy": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ART-\\d{4,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshotPath": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "findingId": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "detail"
              ]
            }
          }
        },
        "required": [
          "artifactId",
          "stage",
          "path",
          "logicalKey",
          "version",
          "label",
          "producer",
          "hash",
          "bytes",
          "createdAt",
          "modifiedAt"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "nextSeq",
    "artifacts"
  ]
}
