{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseforge.local/schemas/finding.schema.json",
  "title": "finding",
  "description": "Stored finding. Generated from src/core/schemas — do not edit.",
  "type": "object",
  "properties": {
    "findingId": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "CONCEPT",
        "RESEARCH_BRIEF",
        "RESEARCH_DOSSIER",
        "INSTRUCTIONAL_DESIGN",
        "STORYBOARD",
        "EDITORIAL",
        "VISUAL_DIRECTION",
        "COURSE_MODEL",
        "COURSE_BUILD",
        "COURSE_QA",
        "RELEASE"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "reviewer",
        "validator",
        "qa",
        "human"
      ]
    },
    "cycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "artifactId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "critical",
        "major",
        "minor",
        "style"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "accuracy",
        "currentness",
        "evidence",
        "citation",
        "completeness",
        "scope",
        "safety",
        "alignment",
        "instructional",
        "cognitive-load",
        "assessment",
        "scenario",
        "accessibility",
        "editorial",
        "consistency",
        "visual",
        "ui",
        "ux",
        "functional",
        "performance",
        "traceability",
        "structure",
        "other"
      ]
    },
    "location": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedAction": {
      "default": "",
      "type": "string"
    },
    "confidence": {
      "default": "medium",
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "default": "open",
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "rejected",
        "fixed",
        "waived",
        "deferred"
      ]
    },
    "mergedFrom": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "findingId",
    "stage",
    "reviewer",
    "source",
    "cycle",
    "severity",
    "category",
    "location",
    "problem"
  ]
}
